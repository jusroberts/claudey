<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for Tailscale/llama.cpp -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Media control -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <!-- For reading installed packages (to check if apps exist) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Microphone for voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location for driving tools (weather, nearby places) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Health Connect: read running sessions for schedule inference -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- Health Connect: allow reading health data from background workers -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Foreground service for persistent accessibility -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- OTA APK sideloading -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Exact alarms for morning briefs (fires through Doze) -->
    <!-- USE_EXACT_ALARM: auto-granted, for reminder/alarm apps (API 33+) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- SCHEDULE_EXACT_ALARM: fallback for API 31-32 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Re-arm alarms after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Allow requesting battery optimization exemption so exact alarms fire reliably -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="WiggleBot"
        android:theme="@style/Theme.WiggleBot"
        android:supportsRtl="true">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent activity that triggers the Health Connect permission dialog -->
        <activity
            android:name=".health.HealthPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Required by Health Connect: rationale screen explaining why we need health data -->
        <activity
            android:name=".health.RationaleActivity"
            android:exported="true"
            android:label="WiggleBot">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- Android Auto driving assistant -->
        <service
            android:name=".car.WiggleBotCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="1" />
        </service>

        <!-- Accessibility service for UI interaction fallback -->
        <service
            android:name=".accessibility.AgentAccessibilityService"
            android:exported="true"
            android:label="WiggleBot Control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".notifications.ParkBookingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.wiggletonabbey.wigglebot.ACTION_BOOK_PARK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.BriefAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.wiggletonabbey.wigglebot.ALARM_RUN_BRIEF" />
                <action android:name="com.wiggletonabbey.wigglebot.ALARM_COMMUTE" />
                <action android:name="com.wiggletonabbey.wigglebot.ALARM_RUN_REMINDER" />
                <action android:name="com.wiggletonabbey.wigglebot.ALARM_AFTERNOON_COMMUTE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>

</manifest>
